# Whitelist: source, runtime content, tests, build tooling, and maintained docs.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/vitest.config.ts
!/demo-initial.yaml
!/.env.example

!/src/
!/tools/
!/scripts/
!/datapack/
!/datapack-dev/
!/public/
!/docs/
!/ai/
!/ui-style/

!/src/**
!/tools/**
!/scripts/**
!/datapack/**
!/datapack-dev/**
!/public/**
!/docs/**
!/ai/**
!/ui-style/**

# Generated output and local tooling state stay excluded even under allowed roots.
**/dist/
**/web-dist/
/src/ui/dist/
**/node_modules/
/.test-artifacts/
/coverage/
/.nyc_output/
/.vite/
/.cache/
/test-results/
/playwright-report/
/prototypes/
/tests/
/.codex/
/.galhcg/
/.playwright-cli/
/.workbuddy/
/docs/archive/
/ai/archive/**
!/ai/archive/README.md

# Local files and editor/OS state.
*.tsbuildinfo
*.swp
*.swo
*~
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.*
!.env.example
!.env.*.example
*.tmp
*.temp
*.bak
/count-src-lines.mjs
/.aoci/
/aoci*.txt
