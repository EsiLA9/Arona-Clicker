{
  "stories": [
    {
      "id": "addition-test:story:welcome",
      "name": "观测站启动",
      "startContext": { "type": "area", "areaId": "addition-test:area:observatory" },
      "stages": { "input": { "advance": "input" }, "ending": { "advance": "auto" } },
      "nodes": [
        {
          "id": "welcome", "type": "talklet", "stageId": "input",
          "content": { "kind": "talk", "speaker": "测试观测员", "text": "欢迎进入 addition_test。这里会覆盖故事、选项、奖励和图鉴记录。" },
          "appearance": { "presentation": { "avatar": "addition-test:avatar(pic):observer" } }
        },
        { "id": "begin", "type": "click", "stageId": "input", "interaction": { "kind": "button", "text": "开始测试。" } },
        {
          "id": "prompt", "type": "talklet", "stageId": "input",
          "content": { "kind": "talk", "speaker": "测试观测员", "text": "请选择要检查的分支。" }
        },
        {
          "id": "select-check", "type": "click", "stageId": "input",
          "interaction": { "kind": "choice", "options": [
            { "id": "registry", "text": "检查 Registry", "marks": ["check-registry"] },
            { "id": "save", "text": "检查存档", "marks": ["check-save"] }
          ] }
        },
        {
          "id": "registry-reward", "type": "operation", "requiresFlag": "check-registry",
          "action": { "kind": "state", "effects": [{ "op": "addItem", "itemId": "addition-test:item:archive-fragment", "amount": 1 }] }
        },
        {
          "id": "save-reward", "type": "operation", "requiresFlag": "check-save",
          "action": { "kind": "state", "effects": [{ "op": "addResource", "resourceId": "base:resource:credit", "amount": 3 }] }
        },
        {
          "id": "done", "type": "talklet", "stageId": "ending",
          "content": { "kind": "talk", "speaker": "测试观测员", "text": "测试完成。你可以在图鉴与统计服务中检查这次记录。" }
        },
        {
          "id": "mark-done", "type": "operation",
          "action": { "kind": "state", "effects": [{ "op": "setFlag", "flagId": "addition_test_story_done", "value": "1" }] }
        }
      ],
      "extra": { "t": "dict", "v": { "category": { "t": "str", "v": "integration" } } }
    },
    {
      "id": "addition-test:story:passive-signal",
      "name": "信号灯闪烁",
      "startContext": { "type": "area", "areaId": "addition-test:area:observatory" },
      "stages": { "line": { "advance": "auto" } },
      "nodes": [{
        "id": "line", "type": "talklet", "stageId": "line",
        "content": { "kind": "talk", "speaker": "测试观测员", "text": "被动故事池也在正常工作。" }
      }]
    }
  ],
  "activeStories": [{
