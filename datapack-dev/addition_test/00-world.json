{
  "name": "Addition Test Pack",
  "version": "0.1.0",
  "inits": [
    {
      "id": "addition-test:init:observatory",
      "name": "扩展测试观测线",
      "description": "用于验证外部数据包如何追加世界线、区域和跨包引用。",
      "defaultAreas": ["addition-test:area:observatory"],
      "startStoryId": "addition-test:story:welcome",
      "purchaseCost": [{ "resourceId": "base:resource:pyroxene", "amount": 1 }],
      "revealTriggers": [{ "reveal": "name", "condition": { "type": "AND", "conditions": [{ "target": "resource", "key": "base:resource:pyroxene", "comparator": ">=", "value": 1 }] } }],
      "tags": [["world", "addition-test"]]
    }
  ],
  "areas": [
    {
      "id": "addition-test:area:observatory",
      "initId": "addition-test:init:observatory",
      "name": "扩展观测站",
      "description": "一个用于检查主题、相邻区域和跨包资源引用的测试区域。",
      "defaultSpots": ["addition-test:spot:scanner"],
      "adjacentAreaIds": ["base:area:schale_main"],
      "tags": [["world", "addition-test"], ["experimental"]],
      "theme": {
        "palette": ["#7c3aed", "#c4b5fd", "#f5f3ff"],
        "tokens": { "primary": "#7c3aed", "accent": "#f59e0b" },
        "background": [{ "kind": "gradient", "value": "linear-gradient(135deg, #1e1b4b 0%, #7c3aed 100%)", "opacity": 0.85 }],
        "presentation": {
          "panels": [{ "region": "centerPanel", "opacity": 0.82, "header": { "eyebrow": "ADDITION TEST" } }],
          "states": [{ "state": "available", "label": "可观测", "icon": "◈", "colorToken": "accent" }]
        }
      }
    }
  ],
  "spots": [
    {
      "id": "addition-test:spot:scanner",
      "areaId": "addition-test:area:observatory",
      "name": "跨包数据扫描仪",
      "description": "同时使用基础包信用点与扩展包 Tag 的测试设施；解锁和逐级升级都通过显式价格组声明。",
      "purchaseOptions": [{ "id": "purchase", "costs": [{ "type": "resource", "resourceId": "base:resource:credit", "amount": { "type": "const", "value": 1 } }] }],
      "maxLevel": 5,
      "levelUpgrades": [
        { "level": 2, "paymentOptions": [{ "id": "upgrade-2", "label": "升级 Lv.2", "costs": [{ "type": "resource", "resourceId": "base:resource:credit", "amount": { "type": "const", "value": 1 } }] }], "effects": [] },
        { "level": 3, "paymentOptions": [{ "id": "upgrade-3", "label": "升级 Lv.3", "costs": [{ "type": "resource", "resourceId": "base:resource:credit", "amount": { "type": "const", "value": 1 } }] }], "effects": [] },
        { "level": 4, "paymentOptions": [{ "id": "upgrade-4", "label": "升级 Lv.4", "costs": [{ "type": "resource", "resourceId": "base:resource:credit", "amount": { "type": "const", "value": 1 } }] }], "effects": [] },
        { "level": 5, "paymentOptions": [{ "id": "upgrade-5", "label": "升级 Lv.5", "costs": [{ "type": "resource", "resourceId": "base:resource:credit", "amount": { "type": "const", "value": 2 } }] }], "effects": [] }
      ],
      "tags": [["experimental"], ["experimental", "scanner"]],
      "functionalities": [
        { "id": "base_flow", "kind": "flow", "resource": "base:resource:credit", "amount": 1 },
        { "id": "scanner_yield", "kind": "linearYield", "resource": "base:resource:credit", "amountPerLevel": 1 },
        { "id": "linear_upgrade", "kind": "linearYield", "resource": "base:resource:credit", "amountPerLevel": 1, "startLevel": 1 }
      ],
      "theme": { "colorGroupId": "addition-test:colorgroup:violet" },
      "extra": { "t": "dict", "v": { "purpose": { "t": "str", "v": "registry-and-save-smoke-test" } } }
    }
  ]
}
