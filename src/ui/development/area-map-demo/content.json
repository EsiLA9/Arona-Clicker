  "stories": [
    {
      "id": "area-map-demo:story:arrival",
      "name": "抵达广场",
      "stages": { "arrival": { "advance": "auto" } },
      "nodes": [
        { "id": "arrival-first", "type": "talklet", "stageId": "arrival", "content": { "kind": "narration", "text": "你穿过街道，抵达了中央广场。" } },
        { "id": "arrival-next", "type": "talklet", "stageId": "arrival", "content": { "kind": "narration", "text": "接下来，去哪里看看呢？" } }
      ]
    }
  ],
  "activeStories": [
    {
      "id": "area-map-demo:activestory:arrival",
      "storyId": "area-map-demo:story:arrival",
      "type": "active",
      "availableInits": [
        "area-map-demo:init:demo"
      ],
      "triggerCondition": {
        "type": "AND",
        "conditions": []
      }
    }
  ],
  "enhancements": [
    {
      "id": "area-map-demo:enhancement:mall_elevator",
      "name": "商场电梯通行",
      "description": "开放入口与各楼层大厅之间的电梯交通。",
      "autoApply": false,
      "effects": [],
      "attachment": {
        "kind": "init",
        "initId": "area-map-demo:init:demo"
      },
      "affectorPackIds": [
        "area-map-demo:affector:mall_elevator"
      ]
    }
  ],
  "affectorPacks": [
