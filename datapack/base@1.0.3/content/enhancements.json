          "reveal": "existence",
          "condition": {
            "type": "OR",
            "conditions": [
              {
                "type": "AND",
                "conditions": [
                  {
                    "target": "spotLevel",
                    "key": "base:spot:hangar_dispatch_deck",
                    "comparator": ">=",
                    "value": 1
                  },
                  {
                    "target": "stat",
                    "key": "$CurrentRunProducedAmount base:resource:credit",
                    "comparator": ">=",
                    "value": 1200
                  }
                ]
              },
              {
                "type": "AND",
                "conditions": [
                  {
                    "target": "hasEnh",
                    "key": "base:enhancement:supply_chain",
                    "comparator": "==",
                    "value": 1
                  },
                  {
                    "target": "hasReadStory",
                    "key": "base:story:schale_flow_show",
                    "comparator": "==",
                    "value": 1
                  }
                ]
              }
            ]
          }
        },
        {
          "reveal": "unlock",
          "condition": {
            "type": "AND",
            "conditions": [
              {
                "target": "countTags",
                "key": "vehicle",
                "comparator": ">=",
                "value": 2
              },
              {
                "type": "OR",
                "conditions": [
                  {
                    "target": "resource",
                    "key": "base:resource:credit",
                    "comparator": ">=",
                    "value": 800
                  },
                  {
                    "target": "hasEnh",
                    "key": "base:enhancement:area_hub",
                    "comparator": "==",
                    "value": 1
                  }
                ]
