{
  "triggerDefs": [
    {
      "id": "base:trigger:first_credit_milestone",
      "on": {
        "kind": "tick"
      },
      "effects": [
        {
          "op": "addResource",
          "target": "base:resource:credit",
          "value": 25
        }
      ],
      "condition": {
        "type": "AND",
        "conditions": [
          {
            "target": "stat",
            "key": "$GlobalProducedAmount base:resource:credit",
            "comparator": ">=",
            "value": 100
          }
        ]
      },
      "once": true
    },
