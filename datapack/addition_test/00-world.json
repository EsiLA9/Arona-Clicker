      "maxLevel": 5,
      "tags": [["experimental"], ["experimental", "scanner"]],
      "functionalities": [{ "id": "scanner_yield", "kind": "linearYield", "resource": "base:resource:credit", "amountPerLevel": 1 }],
      "theme": { "colorGroupId": "addition-test:colorgroup:violet" },
      "extra": { "t": "dict", "v": { "purpose": { "t": "str", "v": "registry-and-save-smoke-test" } } }
