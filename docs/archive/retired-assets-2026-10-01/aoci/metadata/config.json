{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 4000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "aoci-20260927-achievement-demo-release",
        "action": "exclude",
        "pattern": "datapack/area-achievement-demo.zip",
        "pattern_kind": "file",
        "reason": "ZIP 内的 manifest 与两个数据分片和已纳入索引的源目录文件逐字节一致；该包仅作为导入分发产物，不增加独立语义。",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci-20260927-area-achievement-demo",
        "action": "exclude",
        "pattern": "datapack/area-achievement-demo",
        "pattern_kind": "directory",
        "reason": "按用户授权将非正式默认内容的独立演示包从默认整体认知排除；保留数据和说明，演示或成就任务按需读取。",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci-20260927-datapack-editor",
        "action": "exclude",
        "pattern": "tools/datapack-editor",
        "pattern_kind": "directory",
        "reason": "按用户明确偏好将非主要独立数据包编辑器从默认整体认知排除，当前主要编辑入口为 Runtime Editor；保留工具源与 Schema 文件，相关工具或同步任务按需读取。",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci-20260927-plan-work-archive",
        "action": "exclude",
        "pattern": "docs/plan-work/archive",
        "pattern_kind": "directory",
        "reason": "按用户明确的范围收缩指示：历史计划归档仅用于回溯，不作为当前系统事实；保留文档文件本身，并维持当前 Task、docs/docs-828/ 与 docs/ai/ 的索引范围。",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci-20260927-plan-work-goalsets",
        "action": "exclude",
        "pattern": "docs/plan-work/goalsets",
        "pattern_kind": "directory",
        "reason": "按用户明确要求将 Goal Set 从默认整体认知范围排除；保留文件，目标规划需要时按需读取；当前 Task、docs/docs-828/ 与 docs/ai/ 继续索引。",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci-20260927-plan-work-mechanisms",
        "action": "exclude",
        "pattern": "docs/plan-work/mechanisms",
        "pattern_kind": "directory",
        "reason": "按用户授权将冻结考古层排除出默认整体认知；当前机制事实由保留的 docs/docs-828/ 提供；文件保留，相关任务按需读取。",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci-20260927-vitest-report",
        "action": "exclude",
        "pattern": ".vitest-report.json",
        "pattern_kind": "file",
        "reason": "按用户明确的范围收缩要求：该文件是一次测试运行结果快照，不承载当前系统事实；保留文件，仅从 AOCI 管理范围排除。",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci0090-addition-test-duplicate",
        "action": "exclude",
        "pattern": "datapack/addition_test.zip",
        "pattern_kind": "file",
        "reason": "压缩包与另一份 addition-test 包重复，排除重复打包字节以避免认知重复。",
        "decision_basis": "duplicate_semantics",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci0090-addition-test-release",
        "action": "exclude",
        "pattern": "datapack/addition-test-0.1.0.zip",
        "pattern_kind": "file",
        "reason": "压缩包是可由已索引数据目录重建的发布产物，不承载独立于目录内容的认知语义。",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci0090-arona-core-legacy",
        "action": "exclude",
        "pattern": "datapack/arona-clicker-core2.zip",
        "pattern_kind": "file",
        "reason": "该旧压缩包属于数据包产物，未发现独立于数据目录的有效运行时语义。",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci0090-arona-core-release",
        "action": "exclude",
        "pattern": "datapack/arona-clicker-core.zip",
        "pattern_kind": "file",
        "reason": "压缩包由已纳入索引的 AronaClickerCore 数据目录生成，独立包字节不增加源码语义。",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci0090-ba-triangles-asset",
        "action": "exclude",
        "pattern": "src/data/ba_triangles.png",
        "pattern_kind": "file",
        "reason": "当前未发现有效代码引用，且图片像素本身没有可独立验证的仓库认知契约。",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "aoci0090-hoshino-asset",
        "action": "observe",
        "pattern": "src/data/Hoshino.png",
        "pattern_kind": "file",
        "reason": "图片资源由 UI 使用；不创建像素语义 Entry，但保留资源替换的变化观察。",
        "decision_basis": "semantic_density",
        "source": "user",
        "created_by": "codex",
        "order": 200,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [
    "codex"
  ],
  "automation": {
    "mode": "auto"
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
