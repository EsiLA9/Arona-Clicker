{
  "name": "aronaclicker",
  "version": "1.0.0",
  "type": "module",
  "description": "AronaClicker - Blue Archive themed idle/placement game engine",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "dev:game": "vite src/ui",
    "dev:editor": "vite tools/datapack-editor/ui",
    "build": "vite build",
    "gen:schema": "node scripts/gen-engine-schema.mjs --write",
